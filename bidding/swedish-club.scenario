scenario 1hs-1n_opener-14plus-six "Maximum (14+) 1 major opener on a 6-bagger opposite a South hand that might pass 1NT"
  label: 1♥/♠ – 1NT : opener 14+ with six
  formerly: 1major-max-6-carder-maybe-1nt
  system: swedish-club
  north: major-opening and hcp >= 14 and (hearts = 6 or spades = 6)
  # South might pass a 1NT rebid: no raise, limit raise or (in hearts) weak 2S, and no jump shift.
  deal: not (north(hearts = 6) and south(hearts > 3 or (hearts = 3 and hcp in 10..12) or (hcp < 9 and spades >= 7))) and not (north(spades = 6) and south(spades > 3 or (spades = 3 and hcp in 10..12)))
  south: not (hcp >= 10 and (clubs >= 6 or diamonds >= 6 or hearts >= 6))


